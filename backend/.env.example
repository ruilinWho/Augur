# Augur 后端 —— 环境变量模板
# 复制为 `.env`（被 git 忽略）再填。绝不提交真实的 .env。
#
# LLM 网关厂商无关：每个厂商不过是 名字 + base_url + key。
# 角色（chat / deep_research / summarize / cheap）在配置里映射到厂商——
# 于是可把摘要路由到便宜模型、深度分析路由到前沿模型。
#
# 提示：这些值也可在前端「设置 · 数据 / 信源 API」里填，会落到 gitignored
# data/config.local.json（即时生效、界面只显末位、永不入库）。UI 存的值优先于本文件。

# ── 应用 ─────────────────────────────────────────────
AUGUR_PORT=8788
AUGUR_TZ=Asia/Shanghai          # 每日新闻日报任务的时区

# ── LLM 厂商 ─────────────────────────────────────────
# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 通用中转站 / 第三方 relay（OpenAI 兼容）—— base_url 填你的中转地址
RELAY_API_KEY=
RELAY_BASE_URL=

# ── 角色 → 厂商:模型 路由（覆盖默认）───────────────────
# 直连示例（有原厂 key 时）：
AUGUR_ROLE_CHAT=anthropic:claude-opus-4-8
AUGUR_ROLE_DEEP_RESEARCH=anthropic:claude-opus-4-8
# 走中转站示例（OhMyGPT 实测可用：relay:claude-sonnet-4-20250514 / relay:gpt-4o / relay:gpt-4o-mini）：
# AUGUR_ROLE_CHAT=relay:claude-sonnet-4-20250514
# AUGUR_ROLE_DEEP_RESEARCH=relay:gpt-4o
AUGUR_ROLE_SUMMARIZE=deepseek:deepseek-chat
AUGUR_ROLE_CHEAP=deepseek:deepseek-chat

# ── SEC EDGAR（美股个股一手文件，免费无需 key）─────────
# 默认非 PII UA 即可用；最稳妥可填「名字 邮箱」以符合 SEC 公平获取规范：
# AUGUR_SEC_USER_AGENT=Your Name your@email.com

# ── 数据 / 新闻信源 API key（待作者买入后填；也可在「设置」页填）──
# 信源按 财经/新闻/论坛 三类（见 ADR-0007）。免费已接的（行情栈/RSS/Bloomberg/财联社/东财）无需 key。
# 新闻 · X(Twitter) 官方号：经 twtapi 桥（https://twtapi.io/；有免费试用+月付；
# X 官方 key 在 https://console.x.com/，但当前适配器使用 TWTAPI_KEY，见 ADR-0007）
# TWTAPI_KEY=
# 论坛 · Reddit：当前 public JSON 无需 key；官方 Devvit/OAuth 入口见 https://developers.reddit.com/docs/
# 论坛 · 雪球：未确认一手公共内容 API；如启用需登录后从 Cookie 取 xq_a_token/u
# （会失效且绑定真实账号足迹，慎用，见 ADR-0007）
# XUEQIU_TOKEN=
# 论坛 · 小红书：当前只登记配置槽，不默认抓取；官方 Ark App Key 文档：
# https://school.xiaohongshu.com/en/open/quick-start/how-to-get-app-key.html
# 但该开放平台偏商家/Ark，不等于公开笔记搜索 API。
# XHS_COOKIE=
# 注：Tushare Pro / 必盈 / iTick 已按作者要求从设置页移除；太贵的数据终端
# （Reuters/LSEG、万得 Wind、同花顺 iFinD、东财 Choice）此前也已移除（见 ADR-0007）。

# ── 可选：网络/新闻 API key（随功能落地再加）───────────
# TAVILY_API_KEY=
# NEWSAPI_KEY=
